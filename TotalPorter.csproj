<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BinaryExtensionsDotNET" Version="1.1.0" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="2.3.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.2" />
    <PackageReference Include="Yarhl" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HActLib">
      <HintPath>Dependencies\HActLib.dll</HintPath>
    </Reference>
    <Reference Include="LibARMP">
      <HintPath>LibARMP.dll</HintPath>
    </Reference>
    <Reference Include="MotionLib">
      <HintPath>Dependencies\MotionLib.dll</HintPath>
    </Reference>
    <Reference Include="ParLibrary">
      <HintPath>..\..\HActLib\bin\x64\Debug\net6.0\ParLibrary.dll</HintPath>
    </Reference>
    <Reference Include="PIBLib">
      <HintPath>Dependencies\PIBLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="settings.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
